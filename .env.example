# --- Supabase / PostgreSQL ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
# Settings -> API -> JWT Settings -> JWT Secret in the Supabase dashboard.
# Used by the backend to verify the access tokens the frontend sends.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- External APIs ---
OPEN_EXCHANGE_API_KEY=your-openexchangerates-app-id

# --- App ---
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Scheduler ---
SCHEDULER_ENABLED=true
SNAPSHOT_INTERVAL_MINUTES=15

# --- Watchlist defaults (comma separated) ---
# Used only to seed the DB-backed tracked-asset lists on first run and as a fallback
# if those tables are empty. After seeding, manage tracked assets via /admin/assets.
DEFAULT_STOCK_TICKERS=CBA.AX,BHP.AX,CSL.AX,NAB.AX,WBC.AX
DEFAULT_CRYPTO_IDS=bitcoin,ethereum,solana
DEFAULT_FX_PAIRS=USD,EUR,JPY,GBP,NZD

# --- Admin bootstrap ---
# Comma-separated emails auto-promoted to admin the first time they sign in.
ADMIN_EMAILS=you@example.com

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
